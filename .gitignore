*.egg-info/
__pycache__/
.venv/
*.pyc
.pytest_cache/
.benchmarks/
dist/
build/
docs/
logs/
zen-graph-db/
.worktrees/
# tests/fixtures/ is now tracked (text/images directly, PDF/voice via Git LFS)
.agents/*
.claude/*

# Benchmark datasets and model weights, kept locally, never committed.
# See benchmarking.md for download instructions.
models/

# Transient docker build logs (e.g. .build-pro-v4.log)
.build-*.log

# Transient benchmark artifacts from prior exploration (pre-framework).
benchmarks/*.log
benchmarks/results_*.jsonl
benchmarks/results_*.summary.json
benchmarks/mempalace-results/
# Autoresearch runtime state - checkpoints, candidates, result logs
.autoresearch/
# Autoresearch tool: source is tracked; keep secrets + build artifacts out
tools/autoresearch/config.json
tools/autoresearch/__pycache__/
# Baseline/best captures inside algos (autoresearch artefacts)
src/supergraph/algos/*.baseline
src/supergraph/algos/*.best

# Benchmark run artifacts
benchmarks/results/
results/

# Kaggle CLI auto-generated kernel metadata (ephemeral push artifact)
benchmarks/kaggle/kernel-metadata.json

# pytest tmpdir cache
pytest-of-*/
/models/
gemini
test.usearch
data/
.autoresearch/

# Binary fixtures (downloaded via scripts)
tests/fixtures/pdf/*.pdf
tests/fixtures/voice/*.wav
tests/fixtures/voice/*.mp3
hf_token_dataset/
bug_fixes/
.coverage

# Docusaurus build artefacts
website/node_modules/
website/.docusaurus/
website/build/
website/.cache-loader/

# Scratch/exploration scripts at repo root. Real bench entry points live
# under benchmarks/framework/runners/ - anything matching these patterns
# at the top level is throwaway.
/bench_*.py
/bonsai_*.py
/test_reasoning.py

# Secrets. .env holds API keys + local overrides. Never commit it.
# .env.example is the tracked template - copy to .env and fill in values.
/.env

# Local-only Dockerfile variants with BuildKit cache mounts (not for distribution)
Dockerfile*.test

# stray store if a probe passes ":memory:" as a filesystem path
:memory:/
