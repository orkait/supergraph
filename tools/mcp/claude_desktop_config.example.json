{
  "mcpServers": {
    "supergraph": {
      "command": "supergraph-mcp",
      "env": {
        "SUPERGRAPH_DB_PATH": "/absolute/path/to/supergraph-agent.db"
      }
    },
    "supergraph-pro": {
      "command": "supergraph-mcp",
      "env": {
        "SUPERGRAPH_DB_PATH": "/absolute/path/to/supergraph-pro.db",
        "SUPERGRAPH_PROFILE": "pro",
        "HF_TOKEN": "hf_your_token_here_if_needed"
      }
    }
  }
}
