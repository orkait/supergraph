# supergraph - cloud-cpu image for no-GPU serverless (Railway / Fly / Render).
#
# Built FROM LOCAL SOURCE - the published PyPI wheel is stale (no /api/ingest-media,
# no [cloud-cpu] extra). Generation ("understanding": NL->DSL, ANSWER, and
# image/audio/video/pdf media) routes to CLOUD LLMs via litellm. Retrieval runs
# LOCALLY on CPU: a quantised ONNX embedder + ONNX cross-encoder reranker, both
# baked into the image. pymupdf parses PDFs. No GPU, no torch, no local 4B/VLM.
#
# Model slots and why these:
#   embedder  jina-v5-nano-retrieval q4    131 MB  MTEB v2 71.0, 768 dims, 8k ctx
#   reranker  jina-reranker-v1-turbo int8   36 MB  ships onnx/model_int8.onnx,
#                                                  the path OnnxReranker hardcodes
# Both are hf_onnx family, so onnxruntime (already in [cloud-cpu]) is the only
# runtime dep. GGUF embedders/rerankers need llama-cpp-python, which [cloud-cpu]
# deliberately excludes.
#
# Env notes:
#   SUPERGRAPH_MODEL_CACHE            build-time: where install-embedder writes.
#   SUPERGRAPH_VECTOR_MODEL_CACHE_DIR runtime: config.vector.model_cache_dir.
#     Must match the above. SuperGraph calls installer.set_cache_dir() with this
#     value at construction and set_cache_dir wins over SUPERGRAPH_MODEL_CACHE,
#     so at its "./models" default the loader looks in /app/models and misses
#     the baked weights.
#   SUPERGRAPH_VECTOR_EMBEDDER_MAX_LENGTH  VectorConfig defaults to 512 and
#     load_installed_embedder prefers the config value over the manifest's 8192,
#     so leaving it unset silently truncates chunks (chunk_max_size 2000 chars is
#     ~500 tokens before the heading prefix). 1024 clears a full chunk without
#     paying for 8k attention.
#
# The platform injects PORT; the entrypoint binds it (SUPERGRAPH_PORT overrides).
# Set OPENROUTER_API_KEY + SUPERGRAPH_AUTH_TOKEN in the platform env. Never bake
# credentials into this image.
FROM python:3.12-slim-bookworm

# Weights live outside /data so a mounted volume never shadows them, and outside
# /app so a source rebuild does not invalidate the model layer.
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SUPERGRAPH_DB_PATH=/data \
    SUPERGRAPH_HOST=0.0.0.0 \
    SUPERGRAPH_GPU=0 \
    SUPERGRAPH_MODEL_CACHE=/opt/supergraph-models \
    SUPERGRAPH_VECTOR_MODEL_CACHE_DIR=/opt/supergraph-models \
    SUPERGRAPH_VECTOR_EMBEDDER=installed:jina-v5-nano-retrieval \
    SUPERGRAPH_VECTOR_EMBEDDER_MAX_LENGTH=1024 \
    SUPERGRAPH_DSL_RERANKER=onnx \
    SUPERGRAPH_DSL_RERANKER_MODEL_DIR=/opt/supergraph-models/jina-reranker-v1-turbo-en \
    SUPERGRAPH_INGEST_NL_BACKEND=cloud \
    SUPERGRAPH_INGEST_NL_MODELS=openrouter/deepseek/deepseek-v4-flash

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install ".[cloud-cpu]"

# Bake the weights so cold starts do not pay a HuggingFace round trip. Both
# repos are public - no HF token, and none should ever be added here.
RUN supergraph install-embedder jina-v5-nano-retrieval --variant q4
RUN python -c "import os; from huggingface_hub import hf_hub_download; d = os.path.join(os.environ['SUPERGRAPH_MODEL_CACHE'], 'jina-reranker-v1-turbo-en'); [hf_hub_download('jinaai/jina-reranker-v1-turbo-en', f, local_dir=d) for f in ('onnx/model_int8.onnx', 'tokenizer.json')]"

COPY docker/entrypoint.sh /usr/local/bin/supergraph-entrypoint
RUN chmod +x /usr/local/bin/supergraph-entrypoint && mkdir -p /data

EXPOSE 7200
ENTRYPOINT ["/usr/local/bin/supergraph-entrypoint"]
