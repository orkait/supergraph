# Copy to .env and fill in real values. .env is gitignored.
# Read by /env.py at import; exposed as ENV["openrouter_key"] / ENV.openrouter_key.

# OpenRouter API key - paid LLM routes. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Ollama API key - any non-empty string for local. Cloud-hosted Ollama tags
# (like gemma4:31b-cloud) need a real key from https://ollama.com/settings/keys
OLLAMA_API_KEY=ollama


# --- Deploy env (Railway / Fly / Render, Dockerfile.cloud-cpu) ---------------
# Not read by env.py. Set these on the platform, not in a committed file.
# Everything below has a working default baked into Dockerfile.cloud-cpu; listed
# here so operators know what is tunable without reading the Dockerfile.

# Railway: which Dockerfile to build. This service variable is the ONLY thing
# that selects it. railway.json's `dockerfilePath` was silently ignored - the
# builder used the root Dockerfile and failed on its unsupported VOLUME
# directive - so that file was removed rather than left to mislead.
RAILWAY_DOCKERFILE_PATH=Dockerfile.cloud-cpu

# Required. Bearer token for every /api/* request. When unset the entrypoint
# generates one on first boot and prints it to the container log.
SUPERGRAPH_AUTH_TOKEN=

# Required for NL ingest, ANSWER, and /api/ingest-media. Cap the key's spend at
# https://openrouter.ai/keys - the ingest endpoints call an LLM per request.
OPENROUTER_API_KEY=

# NL->DSL + ANSWER model chain (comma-separated, provider-prefixed).
# deepseek-v4-flash: 1M ctx, $0.087/M in, $0.174/M out.
SUPERGRAPH_INGEST_NL_MODELS=openrouter/deepseek/deepseek-v4-flash

# Retrieval quality knobs. Raising rerank cost is the usual first lever.
# SUPERGRAPH_DSL_RERANKER=onnx        # onnx | flashrank | gguf | empty to disable
# SUPERGRAPH_DSL_REMEMBER_WEIGHTS=0.52,0.25,0.15,0.08   # vec,bm25,recency,graph
# SUPERGRAPH_CORE_CEILING_MB=256      # raise on plans with more RAM

# Entity extraction is opt-in and off by default - it adds an ONNX pass per
# write. Point at a TinyBERT-NER model dir to enable.
# SUPERGRAPH_DSL_ENTITY_MODEL_DIR=/opt/supergraph-models/tinybert-ner
